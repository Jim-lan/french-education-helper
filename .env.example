# Copy to .env.local. Never use NEXT_PUBLIC_ for API credentials.
LLM_PROVIDER=gemini
# Choose a supported multimodal Gemini model.
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
# Future adapters; leave blank for V1.
OPENAI_API_KEY=
XAI_API_KEY=

# Household date grouping (set before collecting history).
APP_TIMEZONE=America/Toronto
# Optional for local development; Docker Compose mounts a persistent volume.
# DATA_DIR=./data
